# Copy this file to /etc/autoinsight/backend.env on the server.
# Update the values before starting the backend service.

# Use "manual" if you want to serve a fixed JSON snapshot.
# Use "scrape" only if Chromium/Chrome and Selenium dependencies are installed.
PIPELINE_SOURCE_MODE=scrape
ENABLE_PIPELINE_SCHEDULER=true
PIPELINE_REFRESH_INTERVAL_SECONDS=21600
STALE_RETENTION_SECONDS=259200

# Point these paths to writable locations on the VM.
PIPELINE_SOURCE_JSON=/var/lib/autoinsight/manual/scraped_vehicles.json
MODEL_REPORT_PATH=/var/www/autoinsight/app/autoinsight-frontend/auto-frontend/src/data/Model_Data_Report.xlsx
NORMALIZED_SNAPSHOT_PATH=/var/lib/autoinsight/data/normalized_listings.json
FALLBACK_SNAPSHOT_PATH=/var/lib/autoinsight/data/normalized_listings.fallback.json
RAW_SNAPSHOT_PATH=/var/lib/autoinsight/data/raw_source_snapshot.json
FAVORITES_SNAPSHOT_PATH=/var/lib/autoinsight/data/favorites.json
IMAGE_CACHE_PATH=/var/lib/autoinsight/data/og_image_cache.json

MONGODB_URI=mongodb+srv://autoinsight_user:9Vv3udK8ZdWrmW5@cluster0.hqwosmn.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=autoinsight
MONGODB_COLLECTION=vehicle_listings
MONGODB_FAVORITES_COLLECTION=favorites

# Keep the default empty filters unless you want to scrape a narrower inventory.
SCRAPE_FILTERS_JSON={"vehicle_type":"cars","make":"","model":"","year":""}
SCRAPE_MAX_RESULTS=1000
