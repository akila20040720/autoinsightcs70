# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
DEBUG=False
PORT=5000

# Model Configuration
MODEL_PATH=/app/models
DATA_PATH=/app/data

# API Configuration
API_TITLE=Vehicle Price Prediction API
API_VERSION=1.0.0
MAX_CONTENT_LENGTH=16777216

# Security (Optional)
# SECRET_KEY=your-secret-key-here
# API_KEY=your-api-key-here

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# CORS Configuration
CORS_ORIGIN=*

# Cache Configuration (if using Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=3600
